# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-app-password

# Email Configuration
COMPANY_EMAIL=your-company-email@gmail.com
FROM_EMAIL=your-smtp-user@gmail.com
FROM_NAME=Payivva Technology IT Department

# MySQL Database
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASS=your-db-password
DB_NAME=your-db-name

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Vercel URL (for quote redirect)
VERCEL_URL=https://your-app.vercel.app

# Admin credentials (used by init-db.js)
ADMIN_EMAIL=admin@payivva.com
ADMIN_PASS=change-this-admin-password

# Google Analytics 4 Measurement ID (set in Vercel env for production)
VITE_GA_ID=
